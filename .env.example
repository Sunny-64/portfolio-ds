# ==========================================
# Production Site URL
# ==========================================
# Used for canonical URLs, Open Graph, sitemap.xml, robots.txt, and JSON-LD schema
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ==========================================
# Google Search Console Verification
# ==========================================
# HTML tag verification token (paste the value inside content="...")
GOOGLE_SITE_VERIFICATION=

# ==========================================
# MongoDB Atlas Database
# ==========================================
# Connection string for interaction analytics (never exposed to client browser)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority

